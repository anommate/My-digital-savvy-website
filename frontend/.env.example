# ── WordPress (server-only — never prefix with NEXT_PUBLIC_) ─────────
# REST API base. Today: the live site. After cutover: the CMS subdomain.
#   https://mydigitalsavvy.com/wp-json            (read-only, works now)
#   https://cms.mydigitalsavvy.com/wp-json        (after cutover)
# Leave empty to run on the static homepage content only.
WORDPRESS_API_URL=

# After cutover only: origin that still serves /wp-content/uploads/*.
# Next.js rewrites the old media URLs there so image links keep working.
# WORDPRESS_MEDIA_ORIGIN=https://cms.mydigitalsavvy.com
WORDPRESS_MEDIA_ORIGIN=

# Preview (Draft Mode) reads drafts with a WordPress Application Password
# for a dedicated Editor-role user. Server-only; never reaches the browser.
WORDPRESS_PREVIEW_USER=
WORDPRESS_PREVIEW_APP_PASSWORD=

# Shared secrets with the mds-headless mu-plugin (long random strings).
MDS_REVALIDATE_SECRET=
MDS_PREVIEW_SECRET=

# Public origin used for canonicals, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://mydigitalsavvy.com

# Google Tag Manager container ID. Real value from mds-theme/functions.php
# was GTM-T9RK5XBX — confirm it's still the container in use before reusing it.
NEXT_PUBLIC_GTM_ID=

# Meta Pixel ID. Real value from mds-theme/functions.php was 944128660618504 —
# confirm before reusing.
NEXT_PUBLIC_META_PIXEL_ID=
