# WordPress REST API base URL (server-only — never prefix with NEXT_PUBLIC_).
# Example: https://cms.mydigitalsavvy.com/wp-json
WORDPRESS_API_URL=

# Google Tag Manager container ID. Real value from mds-theme/functions.php
# was GTM-T9RK5XBX — confirm it's still the container in use before reusing it.
NEXT_PUBLIC_GTM_ID=

# Meta Pixel ID. Real value from mds-theme/functions.php was 944128660618504 —
# confirm before reusing.
NEXT_PUBLIC_META_PIXEL_ID=
